{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gleanstudio",

  // **只有一個環境。** 沒有 env 區塊，頂層就是正式環境。
  //
  // 這是刻意的：@astrojs/cloudflare 把設定攤平成 dist/server/wrangler.json 時
  // 不保留 env 區塊，所以 `wrangler deploy --env preview` 不會報錯、只會安靜地
  // 綁上頂層資源。要做多環境就得改用 build 時的 CLOUDFLARE_ENV，那是一整套
  // 額外的複雜度。這個專案的規模不需要 —— 見 docs/07-deployment.md §2
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // adapter v14 走 @cloudflare/vite-plugin，會在建置「之前」解析 main，
  // 所以不能指向還沒產生的 dist/_worker.js（會出現 "main field doesn't point
  // to an existing file"）。指向 adapter 的 entrypoint，由它在建置時接上實際產物。
  "main": "@astrojs/cloudflare/entrypoints/server",

  // ⚠️ directory 必須是 dist/client，**指向 dist 會把 dist/server/ 的伺服器
  //    程式碼當成靜態檔案公開送出**。
  // 這裡不設 html_handling —— 前台契約要求 /Home/About/ 回 200 且不轉址
  //（docs/03-url-contract.md §3.3），而我們的靜態資產只有 /Content 與 /Scripts，
  // 沒有 HTML，動它只會多出風險。
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },

  "vars": {
    // 這兩個本來就印在網頁原始碼裡，是公開值，不是密鑰
    "GA_MEASUREMENT_ID": "G-G2CBNFFB3Q",
    "RECAPTCHA_SITE_KEY": "6LdbNcwcAAAAAND-6LKK67EUEnk6I-9rFboJkV5M"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gleanstudio",
      "database_id": "f311b46f-d288-4a5f-9bb8-38e5aea73558",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gleanstudio-media" }],

  // 後台 session（docs/06-admin-spec.md §2）。
  // 本機 wrangler dev 不看 id，miniflare 自己建；**部署前要先建遠端 namespace**：
  //   wrangler kv namespace create SESSION
  // 再把回傳的 id 填進來。
  // 後台 session（docs/06-admin-spec.md §2）。2026-08-07 建立。
  // 沒有它整個 /backend/* 都會 500 —— middleware 對每個後台請求都寫 CSRF token。
  "kv_namespaces": [{ "binding": "SESSION", "id": "5d3e4b4705c04d26a5be945ca4ff0990" }]
}
