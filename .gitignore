# 舊系統參考程式碼，不納入版控
reference/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# 環境變數與機敏設定
.env
.env.*
!.env.example
.dev.vars

# 資料庫匯出（含明碼管理員密碼）。manifest / anomalies / 兩個順序檔例外，見 docs/05
# 順序檔是 oracle 推導出來的，本機資料重跑產不出來 —— 一定要進版控
# 逐層 unignore —— gitignore 對被排除的目錄不會再看裡面的否定規則
data/*
!data/export/
data/export/*
!data/export/manifest.json
!data/export/anomalies.json
!data/export/legacy-order.json
!data/export/projects-order.json

# 內容匯出進版控 —— CI 要靠它 seed 出資料才跑得了 parity。
# 這些就是公開網站上看得到的東西，沒有機密；**Admins.json 與 admin-hashes.json
# 不在這裡**，前者有舊系統的明碼密碼。見 docs/07-deployment.md §2
!data/export/ArticleTypes.json
!data/export/Articles.json
!data/export/Services.json
!data/export/Teams.json
!data/export/Projects.json
!data/export/Abouts.json
!data/export/Lims.json

# Node
node_modules/
dist/
.cache/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# .NET
bin/
obj/
*.user
*.suo

# 產生物
# binding 型別由 wrangler.jsonc 產生 —— 進版控只會製造「忘了重新產生」的 diff。
# npm run build 的 prebuild 會重跑，CI 也是。
worker-configuration.d.ts
db/seed/
.wrangler/
dist/
.astro/
