---
// ← Views/Home/ArticleDetail.cshtml
import Site from '../../layouts/Site.astro';
import { getArticleTypes, getArticle } from '../../db/queries';
import { getGuid } from '../../lib/query';
import { formatDate } from '../../lib/format';

const articleTypes = await getArticleTypes();
const id = getGuid(Astro.url, 'ArticleID');
const article = id ? await getArticle(id) : null;

// 舊站對不存在的 ArticleID 會 NRE → 500 黃頁（customErrors="Off"）。
// 刻意分歧：回 404。見 docs/09-known-issues.md 4.1
if (!article) return new Response(null, { status: 404 });
---
<Site title={`${article.title} - 禾勤藝術有限公司`} articleTypes={articleTypes}>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 text-center py-4">
            <img src="/Content/images/logo.png">
        </div>
    </div>

    <!--News content-->
    <div class="row justify-content-center">
        <div class="col-11">
            <div class="row justify-content-center">
                <div class="col-12">
                    <div class="news-list">
                        <div class="news-text text-center">
                            <div class="news-text-label-g">{article.typeTitle}</div>
                            <div class="font-34 text-black">{article.title}</div>
                            <small><i>{formatDate(article.createDate)}</i></small>
                        </div>
                        <div class="news-content mx-auto">
                            <Fragment set:html={article.description} />
                        </div>
                    </div>
                </div>
                <div class="col-12 my-5 cursor">
                    <a href="/Home/Articles">
                        <div class="bg-btn mx-auto">
                            &lt; BACK
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
</Site>
