---
// ← Views/Home/Services.cshtml —— ArticleTypes 卡片格，每張連到 Service
import Site from '../../layouts/Site.astro';
import { getArticleTypes } from '../../db/queries';

const articleTypes = await getArticleTypes();
---
<Site title="專業服務項目 - 禾勤藝術有限公司" articleTypes={articleTypes}>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 text-center py-4">
            <img src="/Content/images/logo.png">
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 text-center mb-4">
            <div class="text-title mt-5">Services</div>
        </div>
        <div class="card-group">
{articleTypes.map((t) => (<Fragment>                <a href={`/Home/Service?ArticleTypeID=${t.articleTypeId}`} class="card">
                    <div class={`card-body ${t.bgClass} text-white`}>
                        <h5 class="card-title">{t.title}</h5>
                        <h6 class="card-text text-uppercase">
                            <Fragment set:html={t.subTitle} />
                        </h6>
                        <p class="card-text pt-4">{t.summary}</p>
                    </div>
                    <img src={`/Upload/ArticleTypes/${t.articleTypeId}/${t.photo}`} class="img-fluid">
                </a>
</Fragment>))}        </div>
    </div>
</div>
</Site>
