---
// ← Views/Home/Team.cshtml
// 這頁在舊站沒有任何導覽連結，網址可達但使用者找不到（docs/09-known-issues.md 1.6）
import Site from '../../layouts/Site.astro';
import { getArticleTypes, getTeams } from '../../db/queries';

const [articleTypes, teams] = await Promise.all([getArticleTypes(), getTeams()]);
---
<Site title="禾勤團隊 - 禾勤藝術有限公司" articleTypes={articleTypes}>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 text-center py-4">
            <img src="/Content/images/logo.png">
        </div>
    </div>

    <!--Meet our Team-->
    <div class="row justify-content-center">
        <div class="col-11">
            <div class="row justify-content-center">
                <div class="col-12 text-center mb-4">
                    <div class="text-title mt-5">Meet Our Team</div>
                </div>
{teams.map((t) => (<Fragment>                <div class="col-lg-4 col-12 text-center my-5">
                    <img src={`/Upload/Teams/${t.teamId}/${t.photo}`} class="img-fluid" alt="...">
                    <div class="team-text">
                        <div class="team-text-label">{t.title}</div>
                        <div class="font-14 gray-600">
                            <p>{t.summary}</p>
                        </div>
                        <div class="font-16 text-black mt-3">
                            {t.name}<span class="font-14"> {t.enName}</span>
                        </div>
                    </div>

                </div>
</Fragment>))}            </div>
        </div>
    </div>

</div>
</Site>
