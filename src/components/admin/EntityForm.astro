---
/**
 * 共用的表單。欄位、標籤與**順序**由 src/lib/admin/entities.ts 決定，
 * 三者都逐字照舊後台的 .cshtml —— 包括「代表圖」夾在哪兩個欄位之間。
 *
 * 版面也照舊後台：<legend>{實體}資料</legend> + 標籤在左的 horizontal form。
 */
import Csrf from './Csrf.astro';
import Panel from './Panel.astro';
import RichText from './RichText.astro';
import type { EntityDef } from '../../lib/admin/entities';

interface Props {
  def: EntityDef;
  row?: Record<string, any>;
  /** 面板 header 條上的字 —— 舊後台 `<header><h2>編輯文章</h2></header>` */
  title: string;
  note?: string;
}
const { def, row, title, note } = Astro.props;
const id = row ? String(row[def.idColumn]) : '';
const photo = def.media ? row?.[def.media.photoColumn] : null;
---
<form method="post" action={`/api/admin/${def.key}/save`} enctype="multipart/form-data">
  <Csrf />
  {row && <input type="hidden" name="id" value={id}>}

  <Panel title={title} note={note}>
  <fieldset class="form-block">
    <legend class="form-legend">{def.label}資料</legend>

    {def.fields.map((f) => (
      <div class="form-row">
        {/* 富文本編輯器是 contenteditable，不是 labelable element —— 它自己帶 aria-label */}
        <label class="field-label" for={f.kind === 'richtext' ? undefined : f.column}>{f.label}{f.required && <span class="text-oxide"> ＊</span>}</label>

        {f.kind === 'text' && (
          <input class="field-input" id={f.column} name={f.column} type="text"
                 value={row?.[f.column] ?? ''} required={f.required} autocomplete="off">
        )}

        {f.kind === 'textarea' && (
          <textarea class="field-input" id={f.column} name={f.column} rows="3" required={f.required}
          >{row?.[f.column] ?? ''}</textarea>
        )}

        {f.kind === 'select' && (
          <select class="field-input" id={f.column} name={f.column} required={f.required}>
            {f.options?.map((o) => (
              <option value={o.value} selected={String(row?.[f.column] ?? '') === o.value}>{o.label}</option>
            ))}
          </select>
        )}

        {f.kind === 'richtext' && (
          <RichText name={f.column} value={row?.[f.column] ?? ''} entity={def.key} recordId={id} />
        )}

        {f.kind === 'image' && (
          <input class="field-input" id={f.column} name={f.column}
                 type="file" accept="image/jpeg,image/png,image/gif,image/webp">
        )}

        {f.kind === 'image'
          ? <span class="field-hint">{photo ? '不選就沿用目前這張。' : 'JPEG / PNG / GIF / WebP，10 MB 以內。'}</span>
          : f.hint && <span class="field-hint">{f.hint}</span>}

        {f.kind === 'image' && photo && def.media && (
          <div class="mt-3 flex items-start gap-4">
            <img src={`/Upload/${def.media.entity}/${id}/${photo}`} alt="" width="150"
                 class="border border-bench-deep" loading="lazy">
            <div>
              <div class="eyebrow">目前的圖</div>
              <div class="instrument mt-1 text-ink-faint">{photo}</div>
            </div>
          </div>
        )}
      </div>
    ))}
  </fieldset>

  {/* 動作列在面板底部（舊後台的 .form-actions），順序照舊站：取消 → 確認 */}
  <Fragment slot="foot">
    {row && (
      <a class="live-face live-url" href={def.liveUrl(row)} target="_blank" rel="noopener"
         title={`在新分頁開啟 ${def.liveUrl(row)}`}>{def.liveUrl(row)}</a>
    )}
    {def.singleton === undefined && <a href={`/backend/WebMs/${def.key}`} class="btn btn-quiet">取消</a>}
    {/* 新增與編輯一律「確認」—— 06-admin-spec §10b 明文，舊站六支 Add view
        （AddArticleTypes.cshtml:70 等）也逐字都是「確認」。「新增X」是比較好的
        介面文案，但 §10b 是業主看過第一版說「對不上」之後定的，逐字照舊站優先。 */}
    <button type="submit" class="btn btn-primary">確認</button>
  </Fragment>
  </Panel>
</form>
