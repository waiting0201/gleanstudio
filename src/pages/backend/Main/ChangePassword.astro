---
/**
 * 首次登入強制換密碼。
 *
 * 匯入時每個帳號的 MustChangePassword 都是 1 —— 舊站的密碼是
 * nvarchar(20) 明碼存在資料庫裡（docs/09-known-issues.md §2），
 * 那些密碼全部要當成已外洩。
 */
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Csrf from '../../../components/admin/Csrf.astro';
import Panel from '../../../components/admin/Panel.astro';
import { checkPasswordLength, hashPassword, MIN_PASSWORD_LENGTH, verifyPassword } from '../../../lib/auth/password';
import { verifyCsrf } from '../../../lib/auth/csrf';
import { getSession, SESSION_KEY } from '../../../lib/auth/session';

export const prerender = false;

const session = await getSession(Astro);
if (!session) return Astro.redirect('/backend/Main/Login', 302);

let error = '';
let done = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!(await verifyCsrf(Astro.session as never, form.get('__csrf')))) {
    return new Response('表單已過期。請重新整理頁面再試一次。', { status: 403 });
  }
  const current = String(form.get('current') ?? '');
  const next = String(form.get('next') ?? '');
  const confirm = String(form.get('confirm') ?? '');

  const row = await env.DB.prepare('SELECT PasswordHash FROM Admins WHERE AdminID = ?1')
    .bind(session.adminId).first<{ PasswordHash: string }>();

  if (!row || !(await verifyPassword(current, row.PasswordHash))) {
    error = '目前的密碼不對。';
  } else if (checkPasswordLength(next)) {
    error = checkPasswordLength(next)!;
  } else if (next === current) {
    error = '新密碼要跟目前的不一樣。';
  } else if (next !== confirm) {
    error = '兩次輸入的新密碼不一樣。';
  } else {
    await env.DB.prepare('UPDATE Admins SET PasswordHash = ?1, MustChangePassword = 0 WHERE AdminID = ?2')
      .bind(await hashPassword(next), session.adminId).run();
    Astro.session?.set(SESSION_KEY, { ...session, mustChangePassword: false });
    done = true;
  }
}
---
<Admin title="更改密碼" session={session} bare={session.mustChangePassword && !done}>
<div class="w-full max-w-sm">

  {done ? (
    <Panel title="密碼換好了">
      <p class="text-sm text-ink-soft">下次登入請用新密碼。</p>
      <a slot="foot" href="/backend/Main/Index" class="btn btn-primary">開始工作</a>
    </Panel>
  ) : (
    <form method="post" novalidate>
      <Csrf />
      <Panel title="更改密碼"
             note={session.mustChangePassword ? '先換掉密碼才能繼續' : undefined}>
        <p class="mb-5 text-sm text-ink-soft">
          舊系統把密碼以明碼存在資料庫裡，所以搬過來的密碼一律當成已外洩。
          換一組只有你知道的。
        </p>

        {error && (
          <p role="alert" class="mb-5 border-l-2 border-oxide bg-oxide-wash px-3 py-2 text-sm text-oxide">
            {error}
          </p>
        )}

        <div class="mb-5">
          <label class="field-label" for="current">目前的密碼</label>
          <input class="field-input" id="current" name="current" type="password" autocomplete="current-password" required>
        </div>
        <div class="mb-5">
          <label class="field-label" for="next">新密碼</label>
          <input class="field-input" id="next" name="next" type="password" autocomplete="new-password"
                 minlength={MIN_PASSWORD_LENGTH} required>
          <span class="field-hint">
            {MIN_PASSWORD_LENGTH > 1 ? `至少 ${MIN_PASSWORD_LENGTH} 個字元。長度比複雜度有用。` : '長度比複雜度有用。'}
          </span>
        </div>
        <div>
          <label class="field-label" for="confirm">再輸入一次</label>
          <input class="field-input" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
        </div>

        <button slot="foot" type="submit" class="btn btn-primary">更改密碼</button>
      </Panel>
    </form>
  )}

</div>
</Admin>
