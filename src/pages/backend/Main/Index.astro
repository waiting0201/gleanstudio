---
/**
 * 後台首頁。
 *
 * **刻意不放任何統計方格。** 9 篇文章、1–3 個使用者，KPI 是演戲。
 * 編輯者來這裡只有兩個目的：找到要改的東西，或確認剛才改的東西上線了。
 * 所以這一頁就是「你能進的區塊 + 各有幾筆」加上「最近的文章，每一筆都連著
 * 它真正的公開網址」。
 */
import Admin from '../../../layouts/Admin.astro';
import Panel from '../../../components/admin/Panel.astro';
import { getSession, visibleNav } from '../../../lib/auth/session';
import { getArticlesPage } from '../../../db/queries';
import { formatDate } from '../../../lib/format';
import { env } from 'cloudflare:workers';

export const prerender = false;

const session = await getSession(Astro);
if (!session) return Astro.redirect('/backend/Main/Login', 302);
if (session.mustChangePassword) return Astro.redirect('/backend/Main/ChangePassword', 302);

const groups = await visibleNav(session);
const nav = groups.flatMap((g) => g.items);

// 各區塊筆數 —— 一個數字，不是一張圖表
const TABLES: Record<string, string> = {
  '/backend/WebMs/Articles': 'Articles',
  '/backend/WebMs/ArticleTypes': 'ArticleTypes',
  '/backend/WebMs/Projects': 'Projects',
  '/backend/WebMs/Services': 'Services',
  '/backend/WebMs/Teams': 'Teams',
  '/backend/WebMs/Abouts': 'Abouts',
  '/backend/SettingMs/Admins': 'Admins',
};
const counts = Object.fromEntries(
  await Promise.all(nav.map(async (n) => {
    const table = TABLES[n.href];
    if (!table) return [n.href, null] as const;
    const row = await env.DB.prepare(`SELECT COUNT(*) AS n FROM ${table}`).first<{ n: number }>();
    return [n.href, row?.n ?? 0] as const;
  })),
);

const recent = nav.some((n) => n.href === '/backend/WebMs/Articles')
  ? (await getArticlesPage(1)).items.slice(0, 4)
  : [];
---
<Admin title="首頁" session={session}>

{/* 舊後台的首頁是一個 .jarviswidget，header 寫「禾勤藝術後端管理系統」、
    body 是空的（Main/Index.cshtml:18-31）。這裡把 body 填成「你能維護的區塊
    + 各有幾筆」。 */}
<Panel title="內容維護" note="儲存之後，公開網站會立刻跟著改。" flush>
  {groups.map((group) => (
    <section>
      <p class="panel-group-label">{group.label}</p>
      <ul class="divide-y divide-bench-deep">
        {group.items.map((item) => (
          <li>
            <a href={item.href} class="flex items-baseline justify-between gap-4 px-4 py-2.5 no-underline transition-colors hover:bg-gild-wash">
              <span class="text-sm text-ink">{item.label}</span>
              <span class="eyebrow"><span class="instrument">{counts[item.href] ?? '—'}</span> 筆</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {nav.length < 7 && (
    <p slot="foot" class="field-hint mr-auto">
      沒列出來的區塊代表你的帳號沒有那個權限。需要的話請找管理者開通。
    </p>
  )}
</Panel>

{recent.length > 0 && (
  <Panel title="最近的文章" flush>
    <ul class="divide-y divide-bench-deep">
      {recent.map((a) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-4 py-2.5">
          <div class="min-w-0">
            <div class="record-id">{a.articleId.slice(0, 8)}</div>
            <a href={`/backend/WebMs/EditArticles?ArticleID=${a.articleId}`} class="record-title text-ink no-underline hover:text-brass">{a.title}</a>
          </div>
          <div class="flex shrink-0 items-baseline gap-4">
            <span class="instrument text-ink-faint">{formatDate(a.createDate)}</span>
            {/* 整條網址，不是 slice() 之後手接的「…」—— 截斷交給 .live-url */}
            <a class="live-face live-url" href={`/Home/ArticleDetail?ArticleID=${a.articleId}`} target="_blank" rel="noopener"
               title={`在新分頁開啟 /Home/ArticleDetail?ArticleID=${a.articleId}`}
            >/Home/ArticleDetail?ArticleID={a.articleId}</a>
          </div>
        </li>
      ))}
    </ul>
  </Panel>
)}

</Admin>
