---
/**
 * 案例列表。87 筆，不走共用實體層 —— 它的形狀跟其他實體不一樣。
 *
 * 公開頁 /Home/Project 是四層分組：Type →【標題】、Place → <h5>、
 * Title → <p>、SubTitle → <li>。**分組完全由 LegacyOrder 的先後決定**，
 * 而 Type / Place / Title 是自由文字 —— 打錯一個字就會在公開頁多出一個
 * 全新的分類標題，而且只有一筆。
 *
 * 欄位照舊後台 Views/WebMs/Projects.cshtml:55-61：
 * 排序 / 分類 / 地點 / 專案 / 標題 / 編輯 / 刪除 —— 四個分組欄位各自成一欄，
 * 這正好就讓分組結構看得見。上面多一排依 Type 篩選的頁籤（那是公開頁最外層的分法）。
 */
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import Csrf from '../../../components/admin/Csrf.astro';
import { requirePermission, can } from '../../../lib/auth/session';

export const prerender = false;

const guard = await requirePermission(Astro, 'WebMs/Projects');
if ('response' in guard) return guard.response;
const { session } = guard;

const [mayAdd, mayEdit, mayDelete] = await Promise.all([
  can(session, 'WebMs/AddProjects'),
  can(session, 'WebMs/EditProjects'),
  can(session, 'WebMs/DeleteProjects'),
]);

const type = Astro.url.searchParams.get('type') ?? '';
const q = (Astro.url.searchParams.get('q') ?? '').trim();

// 分類清單依 LegacyOrder 的先後 —— 跟公開頁的分組順序一致，不是字典序
const { results: types } = await env.DB.prepare(
  `SELECT Type, COUNT(*) AS n, MIN(LegacyOrder) AS first
   FROM Projects GROUP BY Type ORDER BY first`,
).all<{ Type: string; n: number; first: number }>();

const where: string[] = [];
const binds: unknown[] = [];
if (type) { where.push(`Type = ?${binds.length + 1}`); binds.push(type); }
if (q) {
  const like = `%${q}%`;
  where.push(`(Place LIKE ?${binds.length + 1} OR Title LIKE ?${binds.length + 2} OR SubTitle LIKE ?${binds.length + 3})`);
  binds.push(like, like, like);
}
const clause = where.length ? `WHERE ${where.join(' AND ')}` : '';

const stmt = env.DB.prepare(
  `SELECT ProjectID, Type, Place, Title, SubTitle, Sort, LegacyOrder
   FROM Projects ${clause} ORDER BY LegacyOrder`,
);
const { results: rows } = await (binds.length ? stmt.bind(...binds) : stmt).all<{
  ProjectID: string; Type: string; Place: string; Title: string;
  SubTitle: string | null; Sort: number; LegacyOrder: number;
}>();

const total = types.reduce((n, t) => n + t.n, 0);
const tabs = [{ label: '全部', value: '', n: total }, ...types.map((t) => ({ label: t.Type, value: t.Type, n: t.n }))];
const href = (t: string) => `?${new URLSearchParams({ ...(t ? { type: t } : {}), ...(q ? { q } : {}) })}`;
---
<Admin title="案例維護" session={session}>

<Flash />

<div class="flex flex-wrap items-baseline justify-between gap-4">
  <div>
    <h1 class="record-title text-2xl">案例維護</h1>
    <p class="eyebrow mt-1">
      <span class="instrument">{total}</span> 筆 · 顯示在 /Home/Project，依分類→地點→標題四層分組
    </p>
  </div>
  {mayAdd && <a href="/backend/WebMs/AddProjects" class="btn btn-primary">新增案例</a>}
</div>

<nav aria-label="依分類篩選" class="mt-7 flex flex-wrap gap-x-4 gap-y-1 border-b border-bench-deep pb-2">
  {tabs.map((t) => (
    <a href={href(t.value)} aria-current={t.value === type ? 'page' : undefined}
       class:list={[
         'text-sm no-underline',
         t.value === type ? 'text-brass' : 'text-ink-soft hover:text-ink',
       ]}>{t.label} <span class="instrument">{t.n}</span></a>
  ))}
</nav>

<form method="get" class="mt-4 flex flex-wrap items-center gap-2">
  {type && <input type="hidden" name="type" value={type}>}
  <input class="field-input max-w-xs" type="search" name="q" value={q}
         placeholder="搜尋地點、標題或項目" aria-label="搜尋案例">
  <button type="submit" class="btn btn-quiet">搜尋</button>
  {(q || type) && <a href="?" class="text-sm text-ink-faint no-underline hover:text-ink">清除</a>}
</form>

{rows.length === 0 ? (
  <div class="record mt-8 p-10 text-center">
    <p class="text-sm text-ink-soft">{q ? `找不到符合「${q}」的案例。` : '這個分類還沒有案例。'}</p>
  </div>
) : (
  <div class="mt-6 overflow-x-auto">
    <table class="grid-table">
      <thead>
        <tr>
          <th class="text-center" style="width:6%">排序</th>
          <th style="width:10%">分類</th>
          <th style="width:14%">地點</th>
          <th style="width:24%">專案</th>
          <th>標題</th>
          {mayEdit && <th class="text-center" style="width:6%">編輯</th>}
          {mayDelete && <th class="text-center" style="width:6%">刪除</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((p) => (
          <tr>
            <td class="text-center align-middle">
              <span class="instrument text-ink-faint" title="公開頁上的排序">{p.LegacyOrder}</span>
            </td>
            <td class="align-middle">{p.Type}</td>
            <td class="align-middle">{p.Place}</td>
            <td class="align-middle">{p.Title}</td>
            <td class="align-middle">
              {mayEdit
                ? <a href={`/backend/WebMs/EditProjects?id=${p.ProjectID}`}
                     class="record-title text-ink no-underline hover:text-brass">{p.SubTitle || '（沒有標題）'}</a>
                : <span class="record-title">{p.SubTitle || '（沒有標題）'}</span>}
            </td>
            {mayEdit && (
              <td class="text-center align-middle">
                <a href={`/backend/WebMs/EditProjects?id=${p.ProjectID}`} class="btn-xs btn-xs-edit">編輯</a>
              </td>
            )}
            {mayDelete && (
              <td class="text-center align-middle">
                <details class="inline-block text-left">
                  <summary class="btn-xs btn-xs-del">刪除</summary>
                  <form method="post" action="/api/admin/Projects/delete" class="mt-2 whitespace-nowrap">
                    <Csrf />
                    <input type="hidden" name="id" value={p.ProjectID}>
                    <span class="mr-2 text-sm text-ink-soft">確定要刪除嗎？</span>
                    <button type="submit" class="btn btn-danger">確定</button>
                  </form>
                </details>
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

<p class="field-hint mt-6">
  公開頁的分組順序由「排序」那一欄的號碼決定，不是由分類或地點的筆劃決定。
  新增的案例會排在最後面。
</p>

<a class="live-face mt-3 inline-block" href="/Home/Project" target="_blank" rel="noopener">/Home/Project ↗</a>

</Admin>
