---
/**
 * 文章列表。每頁 20（舊站也是 20 —— 後台不在凍結範圍內，但沒有理由改）。
 *
 * 每一列都印著它真正的公開網址。整個專案就是為了讓那條網址的輸出不變，
 * 列表不該讓編輯者忘記它在那裡。見 docs/06-admin-spec.md §10
 */
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import Csrf from '../../../components/admin/Csrf.astro';
import { requirePermission, can } from '../../../lib/auth/session';
import { formatDate } from '../../../lib/format';

export const prerender = false;

const guard = await requirePermission(Astro, 'WebMs/Articles');
if ('response' in guard) return guard.response;
const { session } = guard;

const [mayAdd, mayEdit, mayDelete] = await Promise.all([
  can(session, 'WebMs/AddArticles'),
  can(session, 'WebMs/EditArticles'),
  can(session, 'WebMs/DeleteArticles'),
]);

const PER_PAGE = 20;
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('p') ?? '1', 10) || 1);

const total = (await env.DB.prepare('SELECT COUNT(*) AS n FROM Articles').first<{ n: number }>())?.n ?? 0;
const pageCount = Math.max(1, Math.ceil(total / PER_PAGE));

const { results: rows } = await env.DB.prepare(
  `SELECT a.ArticleID AS id, a.Title AS title, a.Photo AS photo, a.CreateDate AS createDate,
          t.Title AS typeTitle, LENGTH(a.Description) AS descLen
   FROM Articles a JOIN ArticleTypes t ON t.ArticleTypeID = a.ArticleTypeID
   ORDER BY a.CreateDate DESC, a.LegacyOrder
   LIMIT ?1 OFFSET ?2`,
).bind(PER_PAGE, (page - 1) * PER_PAGE).all<{
  id: string; title: string; photo: string; createDate: string; typeTitle: string; descLen: number;
}>();
---
<Admin title="文章" session={session}>

<Flash />

<div class="flex flex-wrap items-baseline justify-between gap-4">
  <div>
    <h1 class="record-title text-2xl">文章</h1>
    <p class="eyebrow mt-1"><span class="instrument">{total}</span> 篇 · 顯示在 /Home/Articles 與首頁</p>
  </div>
  {mayAdd && <a href="/backend/WebMs/AddArticles" class="btn btn-primary">新增文章</a>}
</div>

{rows.length === 0 ? (
  <div class="record mt-8 p-10 text-center">
    <p class="text-sm text-ink-soft">還沒有任何文章。</p>
    {mayAdd && <a href="/backend/WebMs/AddArticles" class="btn btn-primary mt-5">寫第一篇</a>}
  </div>
) : (
  <ul class="mt-8 space-y-px">
    {rows.map((a) => (
      <li class="record px-4 py-4">
        <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
          <div class="min-w-0 flex-1">
            <div class="record-id">{a.id.slice(0, 8)}</div>
            <div class="record-title mt-0.5 text-lg">
              {mayEdit
                ? <a href={`/backend/WebMs/EditArticles?ArticleID=${a.id}`} class="text-ink no-underline hover:text-brass">{a.title}</a>
                : a.title}
            </div>
            <div class="eyebrow mt-1">
              {a.typeTitle} · <span class="instrument">{formatDate(a.createDate)}</span>
              {a.descLen > 500_000 && (
                <span class="ml-2 text-oxide">內文 <span class="instrument">{(a.descLen / 1024 / 1024).toFixed(2)}</span> MB —— 偏大</span>
              )}
            </div>
          </div>

          <div class="flex shrink-0 flex-col items-end gap-2">
            <a class="live-face" href={`/Home/ArticleDetail?ArticleID=${a.id}`} target="_blank" rel="noopener"
               title="在新分頁開啟公開頁面">/Home/ArticleDetail?ArticleID={a.id.slice(0, 8)}… ↗</a>
            {mayDelete && (
              <details class="text-right">
                <summary class="cursor-pointer list-none text-sm text-ink-faint hover:text-oxide">刪除</summary>
                <form method="post" action="/api/admin/articles/delete" class="mt-2 flex items-center gap-2">
                  <Csrf />
                  <input type="hidden" name="ArticleID" value={a.id}>
                  <span class="text-sm text-ink-soft">確定刪掉？公開頁面會立刻消失。</span>
                  <button type="submit" class="btn btn-danger">刪除</button>
                </form>
              </details>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
)}

{pageCount > 1 && (
  <nav aria-label="分頁" class="mt-8 flex items-center gap-2">
    {Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
      <a href={`?p=${n}`} aria-current={n === page ? 'page' : undefined}
         class:list={[
           'instrument border px-3 py-1.5 no-underline',
           n === page ? 'border-brass text-brass' : 'border-bench-deep text-ink-soft hover:border-gild',
         ]}>{n}</a>
    ))}
  </nav>
)}

</Admin>
