---
/**
 * 文章列表。每頁 20（舊站也是 20 —— 後台不在凍結範圍內，但沒有理由改）。
 *
 * 欄位照舊後台 Views/WebMs/Articles.cshtml:51-56：
 * 代表圖 / 分類 / 標題 / 日期 / 編輯 / 刪除。舊系統沒有「排序」欄 ——
 * 文章是依日期排的，不是依 Sort。
 *
 * 多出來的一欄是公開網址：整個專案就是為了讓那條網址的輸出不變，
 * 列表不該讓編輯者忘記它在那裡。見 docs/06-admin-spec.md §10
 */
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import Csrf from '../../../components/admin/Csrf.astro';
import Panel from '../../../components/admin/Panel.astro';
import { requirePermission, can } from '../../../lib/auth/session';
import { formatDate } from '../../../lib/format';

export const prerender = false;

const guard = await requirePermission(Astro, 'WebMs/Articles');
if ('response' in guard) return guard.response;
const { session } = guard;

const [mayAdd, mayEdit, mayDelete] = await Promise.all([
  can(session, 'WebMs/AddArticles'),
  can(session, 'WebMs/EditArticles'),
  can(session, 'WebMs/DeleteArticles'),
]);

const PER_PAGE = 20;
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('p') ?? '1', 10) || 1);

const total = (await env.DB.prepare('SELECT COUNT(*) AS n FROM Articles').first<{ n: number }>())?.n ?? 0;
const pageCount = Math.max(1, Math.ceil(total / PER_PAGE));

const { results: rows } = await env.DB.prepare(
  `SELECT a.ArticleID AS id, a.Title AS title, a.Photo AS photo, a.CreateDate AS createDate,
          t.Title AS typeTitle, LENGTH(a.Description) AS descLen
   FROM Articles a JOIN ArticleTypes t ON t.ArticleTypeID = a.ArticleTypeID
   ORDER BY a.CreateDate DESC, a.LegacyOrder
   LIMIT ?1 OFFSET ?2`,
).bind(PER_PAGE, (page - 1) * PER_PAGE).all<{
  id: string; title: string; photo: string; createDate: string; typeTitle: string; descLen: number;
}>();
---
<Admin title="文章維護" session={session}>

<Flash />

<Panel title="文章維護" note={`${total} 篇 · 顯示在 /Home/Articles 與首頁`} flush>

{mayAdd && <a slot="toolbar" href="/backend/WebMs/AddArticles" class="btn btn-primary">新增文章</a>}

{rows.length === 0 ? (
  <div class="p-10 text-center">
    <p class="text-sm text-ink-soft">還沒有任何文章。</p>
    {mayAdd && <a href="/backend/WebMs/AddArticles" class="btn btn-primary mt-5">寫第一篇</a>}
  </div>
) : (
  <div class="panel-scroll">
    <table class="grid-table">
      <thead>
        <tr>
          <th class="text-center" style="width:10%">代表圖</th>
          <th class="text-center" style="width:12%">分類</th>
          <th>標題</th>
          <th class="text-center" style="width:12%">日期</th>
          <th style="width:20%">公開網址</th>
          {mayEdit && <th class="text-center" style="width:6%">編輯</th>}
          {mayDelete && <th class="text-center" style="width:6%">刪除</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((a) => (
          <tr>
            <td class="text-center align-middle">
              {a.photo
                ? <img src={`/Upload/Articles/${a.id}/${a.photo}`} alt="" width="150" loading="lazy"
                       class="inline-block max-w-[150px] border border-bench-deep">
                : <span class="eyebrow">（沒有圖）</span>}
            </td>
            <td class="text-center align-middle">{a.typeTitle}</td>
            <td class="align-middle">
              {mayEdit
                ? <a href={`/backend/WebMs/EditArticles?ArticleID=${a.id}`} class="record-title text-ink no-underline hover:text-brass">{a.title}</a>
                : <span class="record-title">{a.title}</span>}
              <div class="record-id mt-0.5">{a.id.slice(0, 8)}</div>
              {a.descLen > 500_000 && (
                <div class="eyebrow text-oxide">內文 <span class="instrument">{(a.descLen / 1024 / 1024).toFixed(2)}</span> MB —— 偏大</div>
              )}
            </td>
            <td class="text-center align-middle"><span class="instrument">{formatDate(a.createDate)}</span></td>
            <td class="align-middle">
              {/* 印的是那條網址本身，不是「開啟 ↗」—— §10 的簽名元素。
                  太長由 .live-url 用 text-overflow 截，title 仍給完整網址。 */}
              <a class="live-face live-url" href={`/Home/ArticleDetail?ArticleID=${a.id}`} target="_blank" rel="noopener"
                 title={`在新分頁開啟 /Home/ArticleDetail?ArticleID=${a.id}`}
              >/Home/ArticleDetail?ArticleID={a.id}</a>
            </td>
            {mayEdit && (
              <td class="text-center align-middle">
                <a href={`/backend/WebMs/EditArticles?ArticleID=${a.id}`} class="btn-xs btn-xs-edit">編輯</a>
              </td>
            )}
            {mayDelete && (
              <td class="text-center align-middle">
                <details class="inline-block text-left">
                  <summary class="btn-xs btn-xs-del">刪除</summary>
                  <form method="post" action="/api/admin/articles/delete" class="mt-2 whitespace-nowrap">
                    <Csrf />
                    <input type="hidden" name="ArticleID" value={a.id}>
                    <span class="mr-2 text-sm text-ink-soft">確定要刪除嗎？</span>
                    <button type="submit" class="btn btn-danger">確定</button>
                  </form>
                </details>
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}

{/* 舊後台的分頁器在表格底下、面板之內（Articles.cshtml:78-80） */}
{pageCount > 1 && (
  <nav slot="foot" aria-label="分頁" class="mr-auto flex items-center gap-2">
    {Array.from({ length: pageCount }, (_, i) => i + 1).map((n) => (
      <a href={`?p=${n}`} aria-current={n === page ? 'page' : undefined}
         class:list={[
           'instrument border px-3 py-1.5 no-underline',
           n === page ? 'border-brass text-brass' : 'border-bench-deep text-ink-soft hover:border-gild',
         ]}>{n}</a>
    ))}
  </nav>
)}

</Panel>

</Admin>
