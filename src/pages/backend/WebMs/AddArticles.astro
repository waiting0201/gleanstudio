---
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import ArticleForm from '../../../components/admin/ArticleForm.astro';
import { requirePermission } from '../../../lib/auth/session';
import { getArticleTypes } from '../../../db/queries';

export const prerender = false;

const guard = await requirePermission(Astro, 'WebMs/AddArticles');
if ('response' in guard) return guard.response;

const articleTypes = await getArticleTypes();
---
<Admin title="新增文章" session={guard.session}>
<Flash />
<ArticleForm articleTypes={articleTypes}
             title="新增文章" note="儲存之後會立刻出現在公開網站的 /Home/Articles。" />
</Admin>
