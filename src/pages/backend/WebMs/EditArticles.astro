---
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import ArticleForm from '../../../components/admin/ArticleForm.astro';
import { requirePermission } from '../../../lib/auth/session';
import { getArticleTypes, getArticle } from '../../../db/queries';
import { getGuid } from '../../../lib/query';

export const prerender = false;

const guard = await requirePermission(Astro, 'WebMs/EditArticles');
if ('response' in guard) return guard.response;

const id = getGuid(Astro.url, 'ArticleID');
const article = id ? await getArticle(id) : null;
if (!article) return new Response('找不到這篇文章。', { status: 404 });

const articleTypes = await getArticleTypes();
---
<Admin title="編輯文章" session={guard.session}>
<Flash />
<ArticleForm articleTypes={articleTypes} article={article}
             title="編輯文章" note={`${article.title} · 儲存之後公開網站會立刻跟著改。`} />
</Admin>
