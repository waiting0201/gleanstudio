---
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import EntityForm from '../../../components/admin/EntityForm.astro';
import { loadEntity, getRow, primaryColumn } from '../../../lib/admin/load';

export const prerender = false;

const loaded = await loadEntity(Astro, 'Teams', 'edit');
if ('response' in loaded) return loaded.response;
const { def, session } = loaded;

const id = Astro.url.searchParams.get('id') ?? '';
const row = await getRow(def, id.toLowerCase());
if (!row) return new Response('找不到這筆資料。', { status: 404 });
---
<Admin title={`編輯${def.label}`} session={session}>
<Flash />
<div class="record-id">{String(row[def.idColumn]).slice(0, 8)}</div>
<h1 class="record-title mt-1 text-2xl">編輯{def.label}</h1>
<p class="eyebrow mt-1">{row[primaryColumn(def)]} · 儲存之後公開網站會立刻跟著改。</p>
<div class="mt-8"><EntityForm def={def} row={row} /></div>
</Admin>
