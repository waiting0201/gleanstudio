---
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import AdminForm from '../../../components/admin/AdminForm.astro';
import { requirePermission } from '../../../lib/auth/session';
import { limTree, grantsFor } from '../../../lib/admin/admins';

export const prerender = false;

const guard = await requirePermission(Astro, 'SettingMs/EditAdmins');
if ('response' in guard) return guard.response;

const id = Number.parseInt(Astro.url.searchParams.get('id') ?? '', 10);
const row = Number.isFinite(id)
  ? await env.DB.prepare(
      'SELECT AdminID, Name, Username, Email, IsSuperAdmin, MustChangePassword FROM Admins WHERE AdminID = ?1',
    ).bind(id).first<{ AdminID: number; Name: string; Username: string; Email: string | null;
                       IsSuperAdmin: number; MustChangePassword: number }>()
  : null;
if (!row) return new Response('找不到這個管理者。', { status: 404 });

const [lims, granted] = await Promise.all([limTree(), grantsFor(row.AdminID)]);
---
<Admin title="編輯管理者" session={guard.session}>
<Flash />
<AdminForm row={row} lims={lims} granted={granted} isSelf={row.AdminID === guard.session.adminId}
           title="編輯管理者" note={`${row.Name} · ${row.Username}`} />
</Admin>
