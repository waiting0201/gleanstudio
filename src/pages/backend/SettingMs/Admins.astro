---
/** 管理者列表。 */
import { env } from 'cloudflare:workers';
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import Csrf from '../../../components/admin/Csrf.astro';
import { requirePermission, can } from '../../../lib/auth/session';

export const prerender = false;

const guard = await requirePermission(Astro, 'SettingMs/Admins');
if ('response' in guard) return guard.response;
const { session } = guard;

const [mayAdd, mayEdit, mayDelete] = await Promise.all([
  can(session, 'SettingMs/AddAdmins'),
  can(session, 'SettingMs/EditAdmins'),
  can(session, 'SettingMs/DeleteAdmins'),
]);

const { results: rows } = await env.DB.prepare(
  `SELECT a.AdminID, a.Name, a.Username, a.Email, a.IsSuperAdmin, a.MustChangePassword,
          (SELECT COUNT(*) FROM AdminLims l WHERE l.AdminID = a.AdminID) AS lims
   FROM Admins a ORDER BY a.AdminID`,
).all<{ AdminID: number; Name: string; Username: string; Email: string | null;
        IsSuperAdmin: number; MustChangePassword: number; lims: number }>();
---
<Admin title="管理者維護" session={session}>
<Flash />

<div class="flex flex-wrap items-baseline justify-between gap-4">
  <div>
    <h1 class="record-title text-2xl">管理者維護</h1>
    <p class="eyebrow mt-1"><span class="instrument">{rows.length}</span> 個帳號</p>
  </div>
  {mayAdd && <a href="/backend/SettingMs/AddAdmins" class="btn btn-primary">新增管理者</a>}
</div>

{/* 欄位照舊後台 Views/SettingMs/Admins.cshtml:48-52：姓名 / 帳號 / Email / 編輯 / 刪除。
    多一欄「權限」—— 舊系統要點進去才知道對方能碰哪些區塊。 */}
<div class="mt-8 overflow-x-auto">
  <table class="grid-table">
    <thead>
      <tr>
        <th style="width:16%">姓名</th>
        <th>帳號</th>
        <th style="width:22%">Email</th>
        <th style="width:22%">權限</th>
        {mayEdit && <th class="text-center" style="width:6%">編輯</th>}
        {mayDelete && <th class="text-center" style="width:6%">刪除</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((a) => (
        <tr>
          <td class="align-middle">
            {mayEdit
              ? <a href={`/backend/SettingMs/EditAdmins?id=${a.AdminID}`} class="record-title text-ink no-underline hover:text-brass">{a.Name}</a>
              : <span class="record-title">{a.Name}</span>}
            {a.AdminID === session.adminId && <span class="eyebrow ml-2">（你自己）</span>}
          </td>
          <td class="align-middle"><span class="instrument">{a.Username}</span></td>
          <td class="align-middle"><span class="instrument">{a.Email ?? ''}</span></td>
          <td class="align-middle">
            <span class="eyebrow">
              {a.IsSuperAdmin === 1 ? '超級使用者' : `${a.lims} 個區塊`}
              {a.MustChangePassword === 1 && ' · 下次登入要換密碼'}
            </span>
          </td>
          {mayEdit && (
            <td class="text-center align-middle">
              <a href={`/backend/SettingMs/EditAdmins?id=${a.AdminID}`} class="btn-xs btn-xs-edit">編輯</a>
            </td>
          )}
          {mayDelete && (
            <td class="text-center align-middle">
              {a.AdminID === session.adminId ? (
                <span class="eyebrow">—</span>
              ) : (
                <details class="inline-block text-left">
                  <summary class="btn-xs btn-xs-del">刪除</summary>
                  <form method="post" action="/api/admin/Admins/delete" class="mt-2 whitespace-nowrap">
                    <Csrf />
                    <input type="hidden" name="id" value={a.AdminID}>
                    <span class="mr-2 text-sm text-ink-soft">確定要刪除嗎？這個帳號會立刻無法登入。</span>
                    <button type="submit" class="btn btn-danger">確定</button>
                  </form>
                </details>
              )}
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
</Admin>
