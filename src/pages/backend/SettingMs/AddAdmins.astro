---
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import AdminForm from '../../../components/admin/AdminForm.astro';
import { requirePermission } from '../../../lib/auth/session';
import { limTree } from '../../../lib/admin/admins';

export const prerender = false;

const guard = await requirePermission(Astro, 'SettingMs/AddAdmins');
if ('response' in guard) return guard.response;
const lims = await limTree();
---
<Admin title="新增管理者" session={guard.session}>
<Flash />
<AdminForm lims={lims} granted={{}} isSelf={false}
           title="新增管理者" note="建立之後對方就能登入，第一次登入會被要求更改密碼。" />
</Admin>
