{
  "name": "gleanstudio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "export": "node scripts/export-mssql.mjs",
    "hash": "node scripts/hash-passwords.mjs",
    "seed:build": "node scripts/build-seed-sql.mjs",
    "seed:order": "node scripts/build-order-backfill.mjs",
    "golden": "node scripts/capture-golden.mjs",
    "order:derive": "node scripts/derive-order.mjs",
    "db:migrate": "wrangler d1 migrations apply gleanstudio --local",
    "db:migrate:remote": "wrangler d1 migrations apply gleanstudio --remote",
    "db:seed": "wrangler d1 execute gleanstudio --local --file=db/seed/0001-data.sql",
    "db:seed:remote": "wrangler d1 execute gleanstudio --remote --file=db/seed/0001-data.sql",
    "media:upload": "node scripts/upload-r2.mjs --local",
    "media:upload:remote": "node scripts/upload-r2.mjs --remote",
    "verify:d1": "node scripts/verify-d1.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:permissions": "node --experimental-strip-types scripts/verify-permissions.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "./scripts/dev-cycle.sh",
    "parity": "node scripts/parity-diff.mjs",
    "parity:contact": "node scripts/parity-contact.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-kit": "^0.31.10",
    "mssql": "^11.0.1",
    "parse5": "^8.0.1",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "astro": "^7.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1"
  }
}
